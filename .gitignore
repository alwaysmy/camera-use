# ── Python ──────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ── 运行产物 ────────────────────────────────────────────
# ── 研究产物（不进仓库）──────────────────────────────────
# archive/ 是排查期的一次性探测脚本与测试图：里面路径是当时那台机器写死的，
# 只对那台机器有效，不属于工程代码 —— 仅本地存档。
archive/
photos/
captures/
*.avi
*.log

# ── 编辑器 / 系统 ───────────────────────────────────────
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini

# ── 原生 Go 后端 ────────────────────────────────────────
backend/*.exe
backend/*.exe~
backend/captures/
backend/calib/
captures/
calib/

# 旁路视觉：只留 ONNX（运行时用），.pt 是导出源不必入库
backend/models/*.pt
backend/models/.ultralytics/
backend/models/yolov8n-face.pt
backend/models/yolov8n-pose.pt

# CUDA 试装目录（--target 装的，不入库）
backend/.ortgpu/

# 测试图与个人照片（非工程内容，不入库）
archive/test-output/
